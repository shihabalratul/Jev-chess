OPENROUTER_API_KEY=
VISION_MODEL=openai/gpt-6-luna
JEV_MODEL=typesafe/jev-1.13
PORT=3001
HOST=127.0.0.1
PROVIDER_MODE=live
API_TIMEOUT_MS=12000
API_RETRIES=1
# The included public manifest key gives a stable unpacked extension ID.
ALLOWED_EXTENSION_IDS=mhbhlbfdghgmoldmogefdmpkbgedhhcc
CORS_ORIGINS=http://localhost:4173,http://127.0.0.1:4173
# Optional pairing token, configured in extension Settings. Never the OpenRouter key.
BACKEND_TOKEN=

# Persistent sanitized diagnostics; relative to backend working directory. No automatic deletion.
LOG_DIR=./logs

# Dedicated Lichess BOT account only; bot:play scope. Never put this in the extension.
LICHESS_TOKEN=
# Reject Lichess challenges whose estimated length (base + 40 x increment, seconds) is below this.
LICHESS_MIN_CLOCK_SECONDS=300
# Lichess controls require a nonempty BACKEND_TOKEN paired with extension Settings.

{
  "name": "jev-chess",
  "version": "1.3.0",
  "description": "AI chess player that thinks out loud: a Chrome extension and Lichess bot where a language model picks every move, no chess engine.",
  "keywords": [
    "chess",
    "ai",
    "llm",
    "chess-ai",
    "chess-bot",
    "lichess",
    "lichess-bot",
    "chrome-extension",
    "manifest-v3",
    "openrouter",
    "chess.js",
    "typescript"
  ],
  "homepage": "https://shihabalratul.github.io/Jev-chess/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shihabalratul/Jev-chess.git"
  },
  "bugs": {
    "url": "https://github.com/shihabalratul/Jev-chess/issues"
  },
  "author": "shihabalratul",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:server": "tsx watch apps/server/src/index.ts",
    "dev:demo": "vite --config apps/demo-board/vite.config.ts",
    "build": "pnpm typecheck && pnpm build:extension && pnpm build:demo && pnpm build:server",
    "build:extension": "node scripts/build-extension.mjs",
    "build:demo": "vite build --config apps/demo-board/vite.config.ts",
    "build:server": "esbuild apps/server/src/index.ts --bundle --platform=node --format=esm --packages=external --outfile=apps/server/dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:live": "tsx scripts/live-provider-check.ts",
    "start:server": "node apps/server/dist/index.js",
    "check:syntax": "node scripts/check-syntax.mjs",
    "benchmark:jev": "tsx scripts/jev-comparison.ts",
    "lichess:account": "tsx scripts/lichess-account.ts",
    "benchmark:puzzles": "tsx scripts/jev-benchmark.ts",
    "lichess:stats": "tsx scripts/lichess-stats.ts",
    "lichess:report": "tsx scripts/lichess-report.ts"
  },
  "dependencies": {
    "chess.js": "^1.4.0",
    "zod": "^3.24.2",
    "fastify": "^5.2.1",
    "@fastify/cors": "^11.0.0",
    "@fastify/rate-limit": "^10.2.1",
    "dotenv": "^16.4.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.9",
    "@tailwindcss/vite": "^4.0.9",
    "@types/chrome": "^0.0.306",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "tsx": "^4.19.3",
    "esbuild": "^0.25.0",
    "vitest": "^3.0.6",
    "jsdom": "^26.0.0",
    "@playwright/test": "^1.51.0"
  },
  "packageManager": "pnpm@10.11.0"
}
